{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-lab:trace:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "replayable": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "state",
              "model_request",
              "model_response",
              "tool_request",
              "tool_result",
              "retry",
              "failure",
              "artifact",
              "evaluator",
              "measurements",
              "authority",
              "routing",
              "checkpoint",
              "context",
              "child"
            ]
          },
          "metadata": {
            "type": "object"
          },
          "content_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "sequence",
          "kind",
          "metadata",
          "content_ref"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "configuration_id",
    "parent_run_id",
    "replayable",
    "artifacts",
    "events"
  ]
}
