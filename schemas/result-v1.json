{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "fixture_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "fixture_hash"
      ],
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "development",
            "held-out"
          ]
        },
        "repeat": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "split",
        "repeat"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "minProperties": 1
    },
    "hardware": {
      "type": "object",
      "minProperties": 1
    },
    "software": {
      "type": "object",
      "minProperties": 1
    },
    "correctness": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "error",
            "cancelled",
            "unavailable"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "score",
        "evaluator"
      ],
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "generated_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "generated_tokens",
        "model_calls",
        "retries",
        "tool_calls"
      ],
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "properties": {
        "wall_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "inference_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tool_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "setup_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cpu_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gpu_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_ram_bytes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_vram_bytes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cpu_utilization": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gpu_utilization": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "energy_joules": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "wall_seconds",
        "inference_seconds",
        "tool_seconds",
        "setup_seconds",
        "cpu_seconds",
        "gpu_seconds",
        "peak_ram_bytes",
        "peak_vram_bytes",
        "cpu_utilization",
        "gpu_utilization",
        "energy_joules"
      ],
      "additionalProperties": false
    },
    "measurement_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task",
    "protocol",
    "configuration",
    "hardware",
    "software",
    "correctness",
    "work",
    "measurements",
    "measurement_sources",
    "artifacts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-lab:result:v1"
}
